{
  // The Brain and the registry are the real classes. The sandbox is replaced by a recording stub,
  // because containers do not run inside the test runtime.
  "name": "always-on-agent-test",
  "main": "./entry.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "OPENAI_BASE_URL": "https://model.test/v1",
    "OPENAI_API_KEY": "test-key",
    "BRAIN_MODEL": "test-model",
    "WORKER_MODEL": "test-model",
    "ADMIN_KEY": "test-admin",
    "GITHUB_WEBHOOK_SECRET": "test-webhook-secret",
    "GITHUB_TOKEN": "test-github-token"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BRAIN", "class_name": "BrainAgent" },
      { "name": "TASKS", "class_name": "FakeTask" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "exports": {
    "BrainAgent": { "type": "durable-object", "storage": "sqlite" },
    "FakeTask": { "type": "durable-object", "storage": "sqlite" },
    "Registry": { "type": "durable-object", "storage": "sqlite" }
  }
}
