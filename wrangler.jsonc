{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "always-on-agent",
  "main": "src/index.ts",
  // To serve the Worker from a domain of your own, add a route (or deploy with `--domain`).
  // Needed only if a Feishu app uses the webhook transport: Feishu's servers cannot reach workers.dev.
  // "routes": [{ "pattern": "agent.example.com", "custom_domain": true }],
  // Kept explicit: declaring a route turns the workers.dev address off unless it is asked for.
  "workers_dev": true,
  "compatibility_date": "2026-11-01",
  // Files resolves native Linux errno names through node:os.
  "compatibility_flags": ["nodejs_compat"],
  // Markdown shipped with the Worker (the guidance on which worker a piece of work goes to) is read as text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "vars": {
    // Where model calls go. The Brain calls it directly; the sandbox proxy adds the key for this host only.
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "BRAIN_MODEL": "gpt-6-sol",
    // Must be in pi's openai catalog (`pi --list-models`).
    "WORKER_MODEL": "gpt-6-sol"
  },
  // Secrets (wrangler secret put / .dev.vars): OPENAI_API_KEY, ADMIN_KEY,
  // optional GITHUB_WEBHOOK_SECRET, GITHUB_TOKEN; for reading people's Feishu documents:
  // PUBLIC_ORIGIN (https://your.domain) and GRANTS_KEY (32+ random characters)
  "r2_buckets": [{ "binding": "CHECKPOINTS", "bucket_name": "always-on-agent-checkpoints" }],
  "durable_objects": {
    "bindings": [
      { "name": "BRAIN", "class_name": "BrainAgent" },
      { "name": "TASKS", "class_name": "TaskSandbox" },
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "FEISHU_LINKS", "class_name": "FeishuLink" },
      { "name": "FEISHU_GRANTS", "class_name": "FeishuGrant" },
      { "name": "DOUBAO_GRANTS", "class_name": "DoubaoGrant" }
    ]
  },
  "containers": [
    {
      "class_name": "TaskSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "exports": {
    "BrainAgent": { "type": "durable-object", "storage": "sqlite" },
    "TaskSandbox": { "type": "durable-object", "storage": "sqlite" },
    "Registry": { "type": "durable-object", "storage": "sqlite" },
    "FeishuLink": { "type": "durable-object", "storage": "sqlite" },
    "FeishuGrant": { "type": "durable-object", "storage": "sqlite" },
    "DoubaoGrant": { "type": "durable-object", "storage": "sqlite" }
  },
  // The backstop for Feishu long connections; see `scheduled` in src/index.ts.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
