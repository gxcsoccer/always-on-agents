{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doubao-worker-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "SPIKE", "class_name": "Spike" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Spike"] }],
  "vars": {
    // The rendered docs say open.doubao.com; the raw doc source says open.feishu.cn for some
    // endpoints. Switch this to find out which one actually serves the Agent API.
    "DOUBAO_API_BASE": "https://open.doubao.com/open-apis",
    "DOUBAO_ACCOUNTS_BASE": "https://accounts.doubao.com",
    "DOUBAO_SCOPES": "doubao:session:read doubao:session:write doubao:session.event:read doubao:session.event:write doubao:session.message:read offline_access"
  }
  // Secrets (wrangler secret put / .dev.vars): DOUBAO_APP_ID, DOUBAO_APP_SECRET, SPIKE_KEY
}
