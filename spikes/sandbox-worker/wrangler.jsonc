{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandbox-worker-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Files resolves native Linux errno names through node:os.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Where pi's built-in openai provider sends requests. The proxy adds the key for this host only.
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    // A model from pi's openai catalog (`pi --list-models`) that your API key can use.
    "MODEL": "gpt-6-sol"
  },
  // Secrets (wrangler secret put / .dev.vars): OPENAI_API_KEY, SPIKE_KEY, optional GITHUB_TOKEN
  // Checkpoints of each task's workspace, so a lost container can be replaced.
  "r2_buckets": [{ "binding": "CHECKPOINTS", "bucket_name": "sandbox-worker-spike-checkpoints" }],
  "durable_objects": {
    "bindings": [{ "name": "TASKS", "class_name": "TaskSandbox" }]
  },
  "containers": [
    {
      "class_name": "TaskSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "exports": {
    "TaskSandbox": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": true }
}
