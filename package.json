{
  "name": "always-on-agents",
  "version": "0.1.0",
  "description": "An always-on agent on Cloudflare: woken by events, acts unattended, keeps state across runs, and hands long work to sandboxed coding agents.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "eval": "node eval/run.mjs"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@cloudflare/workers-types": "^5.20261008.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.148.0"
  }
}
